# copy to local.properties and fill in, local.properties is gitignored

# 공공데이터포털 key (data.go.kr -> 한국천문연구원_특일 정보)
# use the [디코딩] key from 마이페이지 -> 인증키 발급현황 -> 일반 인증키
# Retrofit URL-encodes it again, so the [인코딩] key fails auth
PUBLIC_DATA_API_KEY=your_public_data_api_key_here

# TMDB API key (developer.themoviedb.org)
TMDB_API_KEY=your_tmdb_api_key_here

# Supabase project URL (dashboard > Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon public key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Android SDK path, set by Android Studio
sdk.dir=/Users/your_username/Library/Android/sdk
